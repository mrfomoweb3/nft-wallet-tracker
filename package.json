    "dotenv": "^16.4.0",
    "ethers": "^6.11.0",
    "grammy": "^1.21.0",
    "ioredis": "^5.3.2",
    "sodium-native": "^4.0.4",
    "uuid": "^9.0.0",
    "viem": "^2.7.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sodium-native": "^2.3.9",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",

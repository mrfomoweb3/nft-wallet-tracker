# NFT Wallet Tracker - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ===========================================
# BLOCKCHAIN RPC ENDPOINTS
# ===========================================

# Ethereum (use Alchemy, Infura, or QuickNode)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private RPC for priority transactions (optional)
ETH_PRIVATE_RPC=https://rpc.flashbots.net

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ===========================================
# DISCORD BOT CONFIGURATION (optional)
# ===========================================

# Get from Discord Developer Portal → Applications → Bot
DISCORD_BOT_TOKEN=
# Application ID from Discord Developer Portal → General Information
DISCORD_CLIENT_ID=
# Optional: Guild/server ID for instant command registration during dev
DISCORD_GUILD_ID=

# ===========================================
# TRADING CONFIGURATION
# ===========================================

# Enable/disable trading (set to false for monitoring only)
TRADING_ENABLED=true

# Maximum spend per transaction in ETH
MAX_SPEND_PER_TX=0.5

# Maximum daily spend in ETH
MAX_DAILY_SPEND=5

# Price tolerance for copy trades (percentage above tracked wallet's price)
PRICE_TOLERANCE=5

# ===========================================
# SAFETY CONFIGURATION
# ===========================================

# Wallet encryption password (MINIMUM 16 characters)
WALLET_ENCRYPTION_PASSWORD=your_secure_password_here_16chars

# Read-only mode (no actual transactions)
READ_ONLY_MODE=false

# Enable flashbots protection
USE_FLASHBOTS=true

# ===========================================
# DATA STORAGE
# ===========================================

# Path for storing user data (JSON files)
DATA_PATH=./data
